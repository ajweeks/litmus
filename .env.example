# Where the SQLite claims database lives (default: ./data/factcheck.db)
FACTCHECK_DB_PATH=

# Where bug reports are emailed. Kept on the server; never shown in the page.
REPORT_TO=
# Bug reports are sent through this SMTP server (e.g. smtps://user:password@smtp.example.com:465).
# Without it, the "Report a bug" form says reports aren't set up.
SMTP_URL=
# Sender address for bug reports (default: the SMTP user).
REPORT_FROM=

# Verdicts are reused across chats by default (the shared cache). Set to "off" to keep reuse and
# duplicate detection within each chat, so one user's conversation can't shape another's verdicts.
FACTCHECK_SHARED_VERDICTS=

# Request limits (defaults shown): body size in bytes, user message length and how much of an
# answer is scanned for claims, in characters.
FACTCHECK_MAX_BODY_BYTES=8388608
FACTCHECK_MAX_MESSAGE_CHARS=100000
FACTCHECK_MAX_CHECK_CHARS=200000
